<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".Home">

    <!-- Main ViewPager Content -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="70dp" />

    <!-- Bottom Navigation Bar Container -->
    <FrameLayout
        android:id="@+id/bottom_nav_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Top divider line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="top"
            android:background="#242936" />

        <!-- Dark Bottom Bar -->
        <LinearLayout
            android:id="@+id/bottom_nav_bar"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:background="@color/tab_bar_background"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:weightSum="4">

            <!-- Tab 1: Início -->
            <FrameLayout
                android:id="@+id/tab_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true">

                <LinearLayout
                    android:id="@+id/tab_home_pill"
                    android:layout_width="84dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center_horizontal|bottom"
                    android:layout_marginBottom="4dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/tab_home_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Início"
                        android:src="@drawable/ic_tab_home"
                        app:tint="@color/tab_inactive_white" />

                    <TextView
                        android:id="@+id/tab_home_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Início"
                        android:textColor="@color/tab_inactive_white"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- Tab 2: Câmera -->
            <FrameLayout
                android:id="@+id/tab_camera"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true">

                <LinearLayout
                    android:id="@+id/tab_camera_pill"
                    android:layout_width="84dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center_horizontal|bottom"
                    android:layout_marginBottom="4dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/tab_camera_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Câmera"
                        android:src="@drawable/ic_tab_camera"
                        app:tint="@color/tab_inactive_white" />

                    <TextView
                        android:id="@+id/tab_camera_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Câmera"
                        android:textColor="@color/tab_inactive_white"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- Tab 3: Histórico -->
            <FrameLayout
                android:id="@+id/tab_history"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true">

                <LinearLayout
                    android:id="@+id/tab_history_pill"
                    android:layout_width="84dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center_horizontal|bottom"
                    android:layout_marginBottom="4dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/tab_history_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Histórico"
                        android:src="@drawable/ic_tab_history"
                        app:tint="@color/tab_inactive_white" />

                    <TextView
                        android:id="@+id/tab_history_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Histórico"
                        android:textColor="@color/tab_inactive_white"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- Tab 4: Ajustes -->
            <FrameLayout
                android:id="@+id/tab_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true">

                <LinearLayout
                    android:id="@+id/tab_settings_pill"
                    android:layout_width="84dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center_horizontal|bottom"
                    android:layout_marginBottom="4dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/tab_settings_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Ajustes"
                        android:src="@drawable/ic_tab_settings"
                        app:tint="@color/tab_inactive_white" />

                    <TextView
                        android:id="@+id/tab_settings_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Ajustes"
                        android:textColor="@color/tab_inactive_white"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
